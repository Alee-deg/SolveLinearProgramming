        <property name="styleSheet">
         <string notr="true">QPushButton {
    background-color: #0078D7; /* Màu xanh Windows */
    color: white;              
    border: 1px solid #005A9E; 
    border-radius: 4px;        /* Bo góc mềm mại */
    padding: 6px 16px;         /* Tạo không gian thở (padding) */
    font-weight: bold;         /* In đậm chữ */
}

/* Hiệu ứng khi rê chuột qua */
QPushButton:hover {
    background-color: #005A9E; 
}

/* Hiệu ứng khi click chuột xuống */
QPushButton:pressed {
    background-color: #004275;
}</string>
