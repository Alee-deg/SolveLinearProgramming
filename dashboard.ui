        <property name="styleSheet">
         <string notr="true">QComboBox {
    border: 1px solid #A0A0A0; /* Viền xám nét căng */
    border-radius: 4px;        /* Bo góc nhẹ */
    padding: 1px 18px 1px 10px; /* Căn lề chữ (đẩy lề phải ra để không đè vào mũi tên) */
    min-height: 40px;          /* Chiều cao bằng với nút Solve/Come back */
    background-color: #FFFFFF; /* Nền trắng */
    color: #000000;
}

/* Hiệu ứng khi lướt chuột qua (Hover) hoặc nhấn vào (Focus) */
QComboBox:hover, QComboBox:focus {
    border: 1px solid #0078D7; /* Chuyển viền xanh Windows */
}

/* 2. Cái nút có mũi tên ở bên phải */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px; /* Độ rộng của nút mũi tên */
    border-left: 1px solid #D0D0D0; /* Có vạch ngăn cách tinh tế */
    background-color: #F5F5F5; /* Màu nền nút hơi xám nhẹ */
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QComboBox::drop-down:hover {
    background-color: #E5E5E5;
}

/* Mũi tên (Qt sẽ tự vẽ lại một mũi tên đen nhỏ nhắn và sắc nét) */
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

/* 3. Khung danh sách khi bấm xổ xuống (Rất quan trọng để không bị xấu) */
QComboBox QAbstractItemView {
    border: 1px solid #A0A0A0;
    background-color: #FFFFFF;
    selection-background-color: #0078D7; /* Màu xanh khi trỏ chuột vào 1 dòng */
    selection-color: #FFFFFF;            /* Chữ đổi thành trắng khi được chọn */
    outline: none;                       /* Xóa cái viền chấm chấm lởm chởm */
}</string>
